// mesh buffers

static const float kPi = 3.14159265358979323846264338327950;
static const float kRad2Deg = 57.2957795;
static const float kDeg2Rad = 0.01745329251994329576923690768489;

static const float kFoliageHeightMutator = 0.321;

ByteAddressBuffer VertexBuffer;
ByteAddressBuffer IndexBuffer;

uint PositionOffset;        // in bytes
uint TexcoordOffset;        // in bytes
uint NormalOffset;          // in bytes
uint VertexBufferStride;    // in bytes
uint indexCount;            // mesh index count
uint FoliageCount;

RWStructuredBuffer<uint> BufferSize;
//RWStructuredBuffer<uint> MinXY;
StructuredBuffer<bool> FeatureMap; // feature map => int[255] 
AppendStructuredBuffer<FoliagePoint> TerrainPoints;     // Calculated points for one mesh
RWStructuredBuffer<FoliagePoint> InputBuffer;           // buffer with all points
ByteAddressBuffer InputCount;                          // actual append count, not buffer capacity
StructuredBuffer<float> PixelToWorld;                   // matrix pixel to world (worldpixel coord)VertexBuffer
AppendStructuredBuffer<FoliagePoint> OutputBuffer;      // buffer with all (frustum) culled points 
RWStructuredBuffer<float4> PixelToObjectCoord;          // xyz: object position, w: mesh coverage
StructuredBuffer<FoliageShaderData> FoliageData;

// textures input
Texture2D<unorm float> SplatMap;
Texture2D<float4> Texture;
Texture2D<unorm float> HeightSurface;
RWTexture2D<float> SurfaceHeightMap;
Texture2D<float> HiZTexture;

int FrameCount;
float4 HiZTextureSize;
uint HiZMaxMipLevel;
float HiZDepthBias;
bool HiZOcclusion;

// Camera
float2 Fov;
float3 CameraPosition;          // camera position in worldPos
float4 frustumPlanes[6];        // Frustum planes (6 planes * 4 floats: [ normal.x, normal.y, normal.z, distance ])
uniform float4x4 WorldToScreen; // Unity clip space, used for screen UVs
float3 CameraRightVector;       // The right vector of the camera
float3 CameraForwardVector;     // The right vector of the camera

// Global Variables
uint BufferCount;
float2 NodeOffset;          // bottom left corner of node in "world" space
uint uvCount;               // the size of surfaceUVs buffer
float2 terrainResolution;   // Resolution of texture/feauture texture
float2 heightResolution;    // Resolution of height texture
float3 terrainSize;         // size of terrain (mesh) size
float2 Resolution;          // the size of each pixel in meters
float Density;              // density of trees
float3 MeshBoundsMax;       // Mesh offset
float4x4 ObjToWorld;        // Local To World
float ScreenCoverage;
float NearCullDistance;


// ************* triangle check ************* //

bool BarycentricInTriangle(float2 pt, float2 v0, float2 v1, float2 v2, out float3 w)
{
    float2 v0v1 = v1 - v0;
    float2 v0v2 = v2 - v0;
    float2 v0pt = pt - v0;

    float d00 = dot(v0v1, v0v1);
    float d01 = dot(v0v1, v0v2);
    float d11 = dot(v0v2, v0v2);
    float d20 = dot(v0pt, v0v1);
    float d21 = dot(v0pt, v0v2);

    float denom = d00 * d11 - d01 * d01;
    if (abs(denom) < 1e-12)
    {
        w = float3(1, 0, 0);
        return false;
    }

    float invDen = 1.0 / denom;

    float u = (d11 * d20 - d01 * d21) * invDen; // weight for v1
    float v = (d00 * d21 - d01 * d20) * invDen; // weight for v2

    float w0 = 1.0 - u - v;
    w = float3(w0, u, v);

    // allow tiny epsilon for edge hits
    const float eps = 1e-6;
    return (u >= -eps) && (v >= -eps) && (u + v <= 1.0 + eps);
}

bool PositionFromUVInTri(
    float2 uv, float2 uv0, float2 uv1, float2 uv2,
    float3 p0, float3 p1, float3 p2,
    out float3 pos)
{
    float3 w;
    bool inside = BarycentricInTriangle(uv, uv0, uv1, uv2, w);
    pos = p0 * w.x + p1 * w.y + p2 * w.z;
    return inside;
}

uint PixelToIndex(uint2 pixel, uint2 resolution)
{
    return pixel.y * resolution.x + pixel.x;
}

uint2 IndexToPixel(uint index, uint2 resolution)
{
    uint y = index / resolution.x;
    uint x = index % resolution.x;
    return uint2(x, y);
}

float Random(float input, float mutator = 0.546)
{
    float nonInteger = 43758.5453; // A different constant to avoid common factors with typical inputs
    float seed = input + mutator * nonInteger;
    return frac(sin(seed) * 12345.6789);
}

float Random2D(float2 input, float mutator = 0.546)
{
    float i = (input.x * 131.071) + (input.y * 655.37);
    return Random(i, mutator);
}

bool TryBilinearPosition(int2 texCoord, float2 frac, out float3 position)
{
    uint index_dl = PixelToIndex(texCoord, terrainResolution);
    uint index_dr = PixelToIndex(int2(texCoord.x + 1, texCoord.y), terrainResolution);
    uint index_ul = PixelToIndex(int2(texCoord.x, texCoord.y + 1), terrainResolution);
    uint index_ur = PixelToIndex(int2(texCoord.x + 1, texCoord.y + 1), terrainResolution);
    
    float4 dl = PixelToObjectCoord[index_dl];
    float4 dr = PixelToObjectCoord[index_dr];
    float4 ul = PixelToObjectCoord[index_ul];
    float4 ur = PixelToObjectCoord[index_ur];

    position = 0;
    if (dl.w == 0 || dr.w == 0 || ul.w == 0 || ur.w == 0)
        return false;

    float3 dx = lerp(dl.xyz, dr.xyz, frac.x);
    float3 ux = lerp(ul.xyz, ur.xyz, frac.x);

    position = lerp(ux, dx, frac.y);
    return true;
}

float2 GetWorldCoord(uint2 texCoord, float3x3 worldToTexCoord, float2 nodeCoord)
{
    float stepsize = 1 / Density;
    float3 worldCoord = mul(worldToTexCoord, float3(texCoord.xy, 1));

    float2 nodeOffset = worldCoord / stepsize;

    float wpx = ceil(nodeOffset.x) * stepsize;
    float wpy = ceil(nodeOffset.y) * stepsize;

    float2 foliageOffset = float2(fmod((wpx - worldCoord.x - Resolution.x), stepsize), fmod((wpy - worldCoord.y - Resolution.y), stepsize));

    float2 WorldPixelCoord = nodeCoord + (texCoord * Resolution);
    return WorldPixelCoord + foliageOffset;
}

float3 GetPosition(uint index)
{
    uint baseAddr = index * VertexBufferStride + PositionOffset;
    float x = asfloat(VertexBuffer.Load(baseAddr + 0));
    float y = asfloat(VertexBuffer.Load(baseAddr + 4));
    float z = asfloat(VertexBuffer.Load(baseAddr + 8));
    
    return float3(x, y, z);
}

float3 GetNormal(uint index)
{
    uint baseAddr = index * VertexBufferStride + NormalOffset;
    float x = asfloat(VertexBuffer.Load(baseAddr + 0));
    float y = asfloat(VertexBuffer.Load(baseAddr + 4));
    float z = asfloat(VertexBuffer.Load(baseAddr + 8));
    
    return float3(x, y, z);
}

float2 GetTexCoord(uint index)
{
    uint baseAddr = index * VertexBufferStride + TexcoordOffset;
    
    float x = asfloat(VertexBuffer.Load(baseAddr + 0));
    float y = asfloat(VertexBuffer.Load(baseAddr + 4));
    
    return float2(x, y);
}

uint3 loadTriangleIndices(uint nTriangle)
{
    uint offsetBytes = nTriangle * 6;
    uint dwordAlignedOffset = offsetBytes & ~3;
    uint2 four16BitIndices = IndexBuffer.Load2(dwordAlignedOffset);

    uint3 indices;
    if (dwordAlignedOffset == offsetBytes)
    {
        indices.x = four16BitIndices.x & 0xffff;
        indices.y = (four16BitIndices.x >> 16) & 0xffff;
        indices.z = four16BitIndices.y & 0xffff;
    }
    else
    {
        indices.x = (four16BitIndices.x >> 16) & 0xffff;
        indices.y = four16BitIndices.y & 0xffff;
        indices.z = (four16BitIndices.y >> 16) & 0xffff;
    }
    return indices;
}

// ************* Handle foliage Height ************* //

int WeightedRandomHeight(float random, float height)
{
    float weightSum = 0;
    for (uint index = 0; index < FoliageCount; index++)
    {
        float heightWeight = FoliageData[index].MaxMin.x > height ? 0 : 1;
        weightSum += FoliageData[index].Weight * heightWeight;
    }

    float r = random * weightSum;

    for (uint i = 0; i < FoliageCount; i++)
    {
        float heightWeight = FoliageData[i].MaxMin.x > height ? 0 : 1;
        r -= (FoliageData[i].Weight * heightWeight);
        if (r >= 0)
            continue;

        if (heightWeight == 0)
            return -1;

        return i;
    }
    return -1;
}

float GetFoliageHeight(FoliagePoint data, FoliageShaderData foliageData)
{
    half random = UnpackHalfHi(data.packed0);
    half surfaceHeight = UnpackHalfLo(data.packed0);

    float2 minMaxHeight = foliageData.MaxMin;
    float2 offset = foliageData.Offset;
    float weight = foliageData.Weight;

    // ********************* ***************  ********************* //
    float foliageHeight = minMaxHeight.x + ((minMaxHeight.y - minMaxHeight.x) * Random(random, kFoliageHeightMutator));
    foliageHeight = clamp(foliageHeight, minMaxHeight.x, surfaceHeight);
    return foliageHeight;
}

// ************* Generate Placement ************* //
[numthreads(8, 8, 1)]
void CSFindBufferSize(uint3 id : SV_DispatchThreadID)
{
    uint feature = uint(SplatMap[id.xy] * 255.0);
    if (FeatureMap[feature])
    {
        InterlockedAdd(BufferSize[0], 1);
    }
}

// ************* surfaceHeight Map Gen ************* //
[numthreads(8, 8, 1)]
void CSSurfaceHeightMap(uint3 id : SV_DispatchThreadID)
{
    float3 color = Texture[id.xy];
    SurfaceHeightMap[id.xy] = 3 + length(color) / 3 * 18;
}

// ************* PixelToObject ************* //
[numthreads(128, 1, 1)]
void CSClearPixelToObject(uint3 id : SV_DispatchThreadID)
{
    uint pixelCount = uint(terrainResolution.x) * uint(terrainResolution.y);
    if (id.x >= pixelCount)
        return;

    PixelToObjectCoord[id.x] = 0;
}

[numthreads(4, 4, 4)]
void CSPixelToObject(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= indexCount)
        return;

    uint3 indexIndices = loadTriangleIndices(id.x);

    if (indexIndices.x == indexIndices.y || indexIndices.x == indexIndices.z || indexIndices.y == indexIndices.z)
        return;
    
    float3 v1 = GetPosition(indexIndices.x);
    float3 v2 = GetPosition(indexIndices.y);
    float3 v3 = GetPosition(indexIndices.z);
    
    float2 uv1 = GetTexCoord(indexIndices.x) * terrainResolution;
    float2 uv2 = GetTexCoord(indexIndices.y) * terrainResolution;
    float2 uv3 = GetTexCoord(indexIndices.z) * terrainResolution;

    // bounding box
    uint Xmin = (uint) floor(min(min(uv1.x, uv2.x), uv3.x));
    uint Xmax = (uint) ceil(max(max(uv1.x, uv2.x), uv3.x));
    uint Ymin = (uint) floor(min(min(uv1.y, uv2.y), uv3.y));
    uint Ymax = (uint) ceil(max(max(uv1.y, uv2.y), uv3.y));

    // --- divide X range into 4 slices based on id.y ---
    uint width = (Xmax >= Xmin) ? (Xmax - Xmin + 1) : 0;
    uint sliceWidth = (width + 3) / 4; // ceil(width/4)
    uint startX = Xmin + id.y * sliceWidth;
    uint endX = min(Xmax, startX + sliceWidth - 1);

    // --- divide Y range into 4 slices based on id.z ---
    uint height = (Ymax >= Ymin) ? (Ymax - Ymin + 1) : 0;
    uint sliceHeight = (height + 3) / 4; // ceil(height/4)
    uint startY = Ymin + id.z * sliceHeight;
    uint endY = min(Ymax, startY + sliceHeight - 1);
    
    for (uint x = startX; x <= endX; x++)
    {
        for (uint y = startY; y <= endY; y++)
        {
            if (x >= uint(terrainResolution.x) || y >= uint(terrainResolution.y))
                continue;

            uint2 uv = uint2(x, y);
            float3 result;
            if (PositionFromUVInTri(uv, uv1, uv2, uv3, v1, v2, v3, result))
            {
                uint index = PixelToIndex(uv, terrainResolution);
                PixelToObjectCoord[index] = float4(result, 1);
            }
        }
    }
}


// ************* Generate Placement ************* //
[numthreads(4, 4, 4)]
void CSPlacement(uint3 id : SV_DispatchThreadID)
{
    float3x3 ToWorldTexCoord =
    {
        PixelToWorld[0], PixelToWorld[1], PixelToWorld[2],
        PixelToWorld[3], PixelToWorld[4], PixelToWorld[5],
        PixelToWorld[6], PixelToWorld[7], PixelToWorld[8],
    };

    float stepsize = (1 / Density);
    uint xCount = ceil(max(Resolution.x * Density, Resolution.x));
    uint yCount = ceil(max(Resolution.y * Density, Resolution.y));

    float subPixelX = (1.0 / xCount);
    float subPixelY = (1.0 / yCount);
    float2 subPixel = float2(subPixelX, subPixelY);

    uint2 uv = id.xy;

    float3 up = mul(ObjToWorld, float4(0, 1, 0, 0)).xyz;
    up.z *= -1;
    float3 east = normalize(mul(ObjToWorld, float4(1, 0, 0, 0)).xyz);
    east.z *= -1;
    
    float3 north = normalize(cross(east, up));
	
    float3x3 M = float3x3(
		east, // first column
		up, // second column
		north // third column
	);
    
    uint feature = uint(SplatMap[uv] * 255);

    if (!FeatureMap[feature])
        return;

    // divide the for loop in 4 threads
    uint threadx = ceil(xCount / 4.0);
    uint start = id.z * threadx;
    uint end = start + threadx;
    end = min(end, xCount);

    // loop throgh all potential points in pixel
    for (uint x = start; x < end; x++)
    {
        for (uint y = 0; y < yCount; y++)
        {
            float2 pixelOffset = subPixel * float2(x, y);
            float3 worldCoord = mul(ToWorldTexCoord, float3(uv.xy + pixelOffset.xy, 1));

            float2 nodeOffset = worldCoord.xy / stepsize;
            float wpx = ceil(nodeOffset.x) * stepsize;
            float wpy = ceil(nodeOffset.y) * stepsize;

            float offsetX = (wpx - worldCoord.x);
            float offsetY = (wpy - worldCoord.y);

            // Each dispatch lane scans multiple candidates, so reject only this one.
            if (offsetX >= (Resolution.x * subPixelX) || offsetY >= (Resolution.y * subPixelY))
                continue;
                                
            float2 randoffset = fmod(GetWorldCoord(uv, ToWorldTexCoord, NodeOffset), 1000);
            float2 rand = randoffset * 0.001;
            rand += Random(rand.x + rand.y);

            float angle = (Random2D(rand, 3.731) * 2 - 1) * 3.141592;
            float2 randDir = float2(cos(angle), sin(angle));
                
            float distance = sqrt(Random2D(rand, 12.243)) * stepsize;
            float2 randomPoint = randDir * distance;

            // BTA local Z runs opposite feature-map Y.
            float2 placementOffset = float2(
                pixelOffset.x * Resolution.x + offsetX,
                -(pixelOffset.y * Resolution.y + offsetY)) + randomPoint;
            float2 placementPixelOffset = placementOffset / Resolution;
            float2 uvfrac = frac(placementPixelOffset);
            int2 uvOffset = int2(floor(placementPixelOffset));
            uvOffset.y *= -1;
            int2 placementUv = int2(uv) + uvOffset;

            // check if uv coord is valid (handle pixel Overlap)
            if (any(placementUv > (int2(terrainResolution) - int2(2, 2))) || any(placementUv < int2(1, 1)))
                continue;

            feature = uint(SplatMap[placementUv] * 255);
            float3 movedCoord;
            if (!TryBilinearPosition(placementUv, uvfrac, movedCoord))
                continue;
                
            if (FeatureMap[feature])
            {
                float3 color = Texture[placementUv].xyz;
                float2 texCoord = clamp(float2(placementUv) - 1.0, 0.0, terrainResolution - 2.0);

                float2 uvHeight = (texCoord / (terrainResolution.xy)) * heightResolution.xy;
                float surfaceHeight = HeightSurface[uvHeight] * 255;

                // Check if surfaceHeight is "Undefined" give random value as in CSSurfaceHeightMap
                if (surfaceHeight <= 0)
                {
                    surfaceHeight = (3 + length(color) / 3 * 18) * 255;
                }
                                    
                float3 coord = movedCoord.xyz;
                    
                FoliagePoint res;
                res.Position = coord.xyz;
                res.ColorA = PackColor(float4(color.rgb, 1));
                res.up = PackNormalOct(up);
                res.right = PackNormalOct(east);
                                            
                res.packed0 = Pack2Half(surfaceHeight, Random2D(rand));
                res.packed1 = Pack2Half(1.0, 0.0); // Visibility=1, pad=0
                        
                TerrainPoints.Append(res);              
            }
        }
    }
}

// ************* Terrain frustum culling ************* //
inline bool IsInFrustum(float3 positionAfterProjection, float threshold)
{
    return (dot(normalize(frustumPlanes[0].xyz), positionAfterProjection) >= threshold &&
        dot(normalize(frustumPlanes[1].xyz), positionAfterProjection) >= threshold &&
        dot(normalize(frustumPlanes[2].xyz), positionAfterProjection) >= threshold &&
        dot(normalize(frustumPlanes[3].xyz), positionAfterProjection) >= threshold);
}

bool ProjectToHiZ(float3 worldPos, out float2 uv)
{
    float4 screenClip = mul(WorldToScreen, float4(worldPos, 1));

    // Bounds crossing or behind the camera cannot be proven hidden conservatively.
    if (screenClip.w <= 0.0001)
    {
        uv = 0;
        return false;
    }

    uv = screenClip.xy / screenClip.w * 0.5 + 0.5;
    return true;
}

float SelectFarthestDepth(float currentDepth, float candidateDepth)
{
    // Raw depth decreases with distance on reversed-Z platforms and increases otherwise.
#if defined(UNITY_REVERSED_Z)
    return min(currentDepth, candidateDepth);
#else
    return max(currentDepth, candidateDepth);
#endif
}

bool IsHidden(
    float3 worldPos,
    float height,
    float groundOffset,
    float cullAreaWidth,
    float3 worldUp)
{
    // Project a tight camera-facing rectangle around the part of the foliage asset configured for
    // occlusion. Using the full billboard width would select coarse mips and include unrelated sky.
    float3 cameraForward = normalize(CameraForwardVector);
    float3 cameraRight = normalize(CameraRightVector);
    float3 foliageUp = normalize(worldUp);

    float3 basePosition = worldPos - foliageUp * groundOffset * height;
    float3 topPosition = basePosition + foliageUp * height;
    float halfCullWidth = height * cullAreaWidth * 0.5;
    float3 rightExtent = cameraRight * halfCullWidth;

    float2 uv0;
    float2 uv1;
    float2 uv2;
    float2 uv3;

    if (!ProjectToHiZ(basePosition - rightExtent, uv0) ||
        !ProjectToHiZ(basePosition + rightExtent, uv1) ||
        !ProjectToHiZ(topPosition - rightExtent, uv2) ||
        !ProjectToHiZ(topPosition + rightExtent, uv3))
    {
        return false;
    }

    float nearestFoliageEyeDepth =
        min(
            dot(basePosition - CameraPosition, cameraForward),
            dot(topPosition - CameraPosition, cameraForward)) -
        halfCullWidth;

    if (nearestFoliageEyeDepth <= 0.0)
        return false;

    float2 minUv = min(min(uv0, uv1), min(uv2, uv3));
    float2 maxUv = max(max(uv0, uv1), max(uv2, uv3));

    if (any(maxUv < 0.0) || any(minUv > 1.0))
        return false;

    minUv = saturate(minUv);
    maxUv = saturate(maxUv);

    float2 extentInPixels = (maxUv - minUv) * HiZTextureSize.xy;
    float largestExtent = max(extentInPixels.x, extentInPixels.y);

    // Choose the finer adjacent mip. This keeps the projected bounds within at most a 3x3 texel
    // footprint without pulling distant background from one excessively coarse texel.
    uint mipLevel = (uint) floor(log2(max(largestExtent, 1.0)));
    mipLevel = min(mipLevel, HiZMaxMipLevel);

    uint2 mipSize = max(uint2(1, 1), uint2(HiZTextureSize.xy) >> mipLevel);
    uint2 maxCoordinate = mipSize - 1;
    uint2 minCoordinate = min((uint2) floor(minUv * mipSize), maxCoordinate);
    uint2 maxSampleCoordinate = min((uint2) floor(maxUv * mipSize), maxCoordinate);
    uint2 sampleSpan = min(maxSampleCoordinate - minCoordinate, uint2(2, 2));

#if defined(UNITY_REVERSED_Z)
    float farthestSceneDepth = 1.0;
#else
    float farthestSceneDepth = 0.0;
#endif

    [unroll]
    for (uint y = 0; y < 3; y++)
    {
        [unroll]
        for (uint x = 0; x < 3; x++)
        {
            if (x <= sampleSpan.x && y <= sampleSpan.y)
            {
                farthestSceneDepth = SelectFarthestDepth(
                    farthestSceneDepth,
                    HiZTexture.Load(int3(minCoordinate + uint2(x, y), mipLevel)));
            }
        }
    }

    // Cull only when the nearest possible foliage point is behind the farthest scene depth across
    // every covered texel. Eye-space comparison keeps the bias stable at all camera distances.
    float farthestSceneEyeDepth = LinearEyeDepth(farthestSceneDepth);
    return nearestFoliageEyeDepth > farthestSceneEyeDepth + HiZDepthBias;
}

float CalculateDesiredDistance(float vFov, float objectHeight, float coverage)
{
    float halfFov = vFov * 0.5 * kDeg2Rad;

    return objectHeight / (2.0 * tan(halfFov) * coverage);
}

bool GetRandomizedData(FoliagePoint data, out FoliageShaderData output)
{
    float surfaceHeight = UnpackHalfLo(data.packed0);
    float random = UnpackHalfHi(data.packed0);
        
    int type = floor(random * FoliageCount);
    type = WeightedRandomHeight(random, surfaceHeight);
    if (type < 0)
        return false;
    
    output = FoliageData[type];
    return true;
}

// ************* Cull Points ************* //
[numthreads(128, 1, 1)]
void CSCull(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= InputCount.Load(0))
        return;

    FoliagePoint data = InputBuffer[id.x];
            
    if (dot(data.Position, data.Position) == 0)
        return;
    
    FoliageShaderData foliageData = (FoliageShaderData) 0;
    bool dataFound = GetRandomizedData(data, foliageData);
    
    if (!dataFound)
        return;
    
    float height = GetFoliageHeight(data, foliageData);
    
    if (height == 0)
        return;

    float3 worldUp = UnpackNormalOct(data.up);
    float3 topPadding = worldUp * height * 0.1;
    float3 topOffset = worldUp * (height - foliageData.Offset.y * height) - topPadding;
    float3 pos = mul(ObjToWorld, float4(data.Position.xyz, 1)).xyz;

    float3 FoliageMid = pos + topOffset * 0.45;
    float3 toFoliageMid = FoliageMid - CameraPosition;
    
    float distance = length(toFoliageMid);
    float desiredDistance = CalculateDesiredDistance(Fov.y/*This includes padding for shadows, but should maybe not*/, height, ScreenCoverage);

    bool isWithinNearCullDistance =
        NearCullDistance > 0.0 && distance <= NearCullDistance;
    float visibility = UnpackHalfLo(data.packed1);

    if (isWithinNearCullDistance)
    {
        visibility = max(visibility - 0.01f, 0.0);
        data.packed1 = Pack2Half(visibility, 0);
        InputBuffer[id.x] = data;

        if (visibility <= 0)
            return;
    }

    if (desiredDistance < distance)
        return;
  
    // ****** falloff ******
    if (distance > desiredDistance * 0.50)
    {
        float seed = UnpackHalfHi(data.packed0);
    
        float percentage = (distance - (desiredDistance * 0.50)) / (frustumPlanes[5].w * 0.5);
        if (percentage > seed)
            return;
    }

    // Early-out if not in frustum
    if (!IsInFrustum(toFoliageMid, -height))
        return;
    
    // Recover visibility only on matching frames outside the near-cull range.
    if (!isWithinNearCullDistance && (uint) FrameCount % 2 == id.x % 2)
    {
        bool hidden =
            HiZOcclusion &&
            IsHidden(
                pos,
                height,
                foliageData.Offset.y,
                foliageData.CullAreaWidth,
                worldUp);
        // If not hidden, increase visibility up to a limit
        if (!hidden && visibility <= 1.0)
            visibility += 0.25;
    }
        
    // Early-out if fully invisible
    if (visibility <= 0)
        return;
    
    // Otherwise decay a bit
    if (!isWithinNearCullDistance)
        visibility -= 0.01f;
        
    data.packed1 = Pack2Half(visibility, 0);
    InputBuffer[id.x] = data;
        
    data.Position = pos;
    OutputBuffer.Append(data);
}

[numthreads(128, 1, 1)]
void CSClear(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= BufferCount)
        return;
    
    FoliagePoint res;
    res.Position = float3(0, 0, 0);
    res.ColorA = 0;
    
    res.up = 0;
    res.right = 0;
        
    res.packed0 = 0;
    res.packed1 = 0;
    
    TerrainPoints.Append(res);
}